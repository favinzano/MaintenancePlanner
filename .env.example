# Supabase project URL and publishable key are public Auth configuration.
VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_key

# Server-only configuration. Never use these names with a VITE_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_key
SUPABASE_SECRET_KEY=sb_secret_local_development_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Set to Supabase's downloaded root CA file for remote PostgreSQL connections.
DATABASE_SSL_CA_FILE=
API_PORT=3001
API_HOST=127.0.0.1
PLANNERMC_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
SUPABASE_INVITE_REDIRECT_URL=http://127.0.0.1:4173
