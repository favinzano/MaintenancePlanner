# Supabase project URL and publishable key are public Auth configuration.
VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_key

# Server-only configuration. Never use these names with a VITE_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development_key
SUPABASE_SECRET_KEY=sb_secret_local_development_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Set to Supabase's downloaded root CA file for remote PostgreSQL connections.
DATABASE_SSL_CA_FILE=
API_PORT=3001
API_HOST=127.0.0.1
PLANNERMC_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
PLANNERMC_ENVIRONMENT=local
SUPABASE_INVITE_REDIRECT_URL=http://127.0.0.1:4173

# Manual intake stays disabled until measured limits are set for this environment.
# Text extraction and OCR run in the browser; only the requested original file is sent to PlannerMC for database storage.
MANUAL_UPLOAD_ENABLED=false
MANUAL_MAX_FILE_BYTES=
MANUAL_MAX_PDF_PAGES=
MANUAL_MAX_TOTAL_MANUAL_BYTES=

# Production uploads also require reviewed capacity and tested database backups.
MANUAL_PRODUCTION_UPLOADS_ENABLED=false
MANUAL_PRODUCTION_DATABASE_PLAN=
MANUAL_PRODUCTION_BACKUP_RETENTION_DAYS=
MANUAL_PRODUCTION_CAPACITY_REVIEWED_AT=
MANUAL_PRODUCTION_BACKUP_RESTORE_TESTED_AT=
